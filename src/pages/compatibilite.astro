        Singe: ['Rat', 'Dragon'],
        Coq: ['Buffle', 'Serpent'],
        Chien: ['Tigre', 'Cheval'],
        Cochon: ['Lapin', 'Chèvre']
    };

    return compatibility[userSign] ?? [];
}
function getCompatibleBirthYears(
    ageMin: number,
    ageMax: number,
    idealChineseSigns: string[]
): number[] {
    const currentYear = new Date().getFullYear();

    const youngestBirthYear = currentYear - ageMin;
    const oldestBirthYear = currentYear - ageMax;

    const years: number[] = [];

    for (
        let year = oldestBirthYear;
        year <= youngestBirthYear;
        year++
    ) {
        const sign = getChineseSign(year);

        if (idealChineseSigns.includes(sign)) {
            years.push(year);
        }
    }

    return years;
}


