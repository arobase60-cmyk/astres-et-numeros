function getIdealChineseSigns(userSign: string) {
    const compatibility: Record<string, string[]> = {
        Rat: ['Dragon', 'Singe'],
        Buffle: ['Serpent', 'Coq'],
        Tigre: ['Cheval', 'Chien'],
        Lapin: ['Chèvre', 'Cochon'],
