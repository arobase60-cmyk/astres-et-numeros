function getWesternSignFromDate(dateString: string) {
    const [, month, day] = dateString.split('-').map(Number);

    const signs = [
        { name: 'Capricorne', from: 1222 },
        { name: 'Verseau', from: 120 },
        { name: 'Poissons', from: 219 },
        { name: 'Bélier', from: 321 },
        { name: 'Taureau', from: 420 },
        { name: 'Gémeaux', from: 521 },
        { name: 'Cancer', from: 621 },
        { name: 'Lion', from: 723 },
        { name: 'Vierge', from: 823 },
        { name: 'Balance', from: 923 },
        { name: 'Scorpion', from: 1023 },
        { name: 'Sagittaire', from: 1122 }
    ];

    const value = month * 100 + day;

    for (let i = signs.length - 1; i >= 0; i--) {
        if (value >= signs[i].from) {
            return signs[i].name;
        }
    }

    return 'Capricorne';
}

function getIdealWesternSign(userSign: string) {
    let bestSign = '';
    let bestScore = -1;

    for (const sign of WESTERN_SIGNS) {
        const result = getCompatibility(userSign, sign.name);

        if (result && result.score > bestScore) {
            bestScore = result.score;
            bestSign = sign.name;
        }
    }

    return {
        sign: bestSign,
        score: bestScore
    };
}
