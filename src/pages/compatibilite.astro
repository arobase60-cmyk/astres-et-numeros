function reduceNumber(n: number): number {
    while (n > 9 && n !== 11 && n !== 22 && n !== 33) {
        n = String(n)
            .split('')
            .reduce((sum, digit) => sum + Number(digit), 0);
    }

    return n;
}

function getLifePath(dateString: string) {
    const digits = dateString.replace(/\D/g, '');
    const total = digits
        .split('')
        .reduce((sum, digit) => sum + Number(digit), 0);

    return reduceNumber(total);
}

function getIdealNumbers(lifePath: number): number[] {
    const compatibility: Record<number, number[]> = {
        1: [3, 5],
        2: [6, 8],
        3: [1, 5],
        4: [6, 8],
        5: [1, 3],
        6: [2, 4],
        7: [7, 9],
        8: [2, 4],
        9: [7, 9],
        11: [2, 6],
        22: [4, 8],
        33: [6, 9]
    };

    return compatibility[lifePath] ?? [lifePath];
}

function getFirstNameNumber(firstName: string): number {
    const normalized = firstName
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toUpperCase()
        .replace(/[^A-Z]/g, '');

    let total = 0;

    for (const letter of normalized) {
        const position = letter.charCodeAt(0) - 64;
        total += ((position - 1) % 9) + 1;
    }

    return reduceNumber(total);
}
function getPersonalNumerology(firstName: string, lifePath: number) {
    const firstNameNumber = getFirstNameNumber(firstName);

    const combinedNumber = reduceNumber(
        firstNameNumber + lifePath
    );

    return {
        firstNameNumber,
        combinedNumber
    };
}


function getCompatibleFirstNames(
    gender: string,
    idealNumbers: number[]
): string[] {
    const names =
        gender === 'homme'
            ? MALE_FIRSTNAMES
            : FEMALE_FIRSTNAMES;

    return names
        .filter(name => idealNumbers.includes(getFirstNameNumber(name)))
        .slice(0, 8);
}


}

