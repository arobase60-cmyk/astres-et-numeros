---
import Layout from '../../layouts/Layout.astro';
import { tarotCards } from '../../data/tarot';
---

<Layout title="Tirage Tarot 3 cartes - Astres & Numéros">

	<section class="hero">
		<p class="eyebrow">TIRAGE 3 CARTES</p>

		<h1>Passé · Présent · Avenir</h1>

		<p>
			Pensez à une situation précise, puis choisissez trois cartes.
			La première représentera le passé, la deuxième le présent
			et la troisième l’avenir.
		</p>
	</section>

	<section class="progress-box">
		<div class="progress-step active" id="step-0">
			<span>1</span>
			<p>Passé</p>
		</div>

		<div class="progress-line"></div>

		<div class="progress-step" id="step-1">
			<span>2</span>
			<p>Présent</p>
		</div>

		<div class="progress-line"></div>

		<div class="progress-step" id="step-2">
			<span>3</span>
			<p>Avenir</p>
		</div>
	</section>

	<section id="choice-zone">

		<div class="instructions">
			<p id="instruction-text">
				Choisissez une carte pour représenter votre passé.
			</p>
		</div>

		<div class="deck" id="deck">

			{tarotCards.map((card, index) => (

				<button
					class="card-back"
					type="button"
					data-index={index}
					aria-label={`Choisir la carte ${index + 1}`}
				>
					<div class="card-pattern">
						<div class="moon">☾</div>
						<div class="star">✦</div>
						<div class="brand-small">A & N</div>
					</div>
				</button>

			))}

		</div>

	</section>

	<section class="result hidden" id="result">

		<p class="result-label">
			VOTRE TIRAGE
		</p>

		<div class="spread">

			<article class="spread-card">

				<p class="position-title">
					PASSÉ
				</p>

				<img
					id="past-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="past-number"></p>

				<h2 id="past-name"></h2>

				<div
					class="keywords"
					id="past-keywords"
				></div>

				<p
					class="meaning"
					id="past-meaning"
				></p>

			</article>

			<article class="spread-card">

				<p class="position-title">
					PRÉSENT
				</p>

				<img
					id="present-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="present-number"></p>

				<h2 id="present-name"></h2>

				<div
					class="keywords"
					id="present-keywords"
				></div>

				<p
					class="meaning"
					id="present-meaning"
				></p>

			</article>

			<article class="spread-card">

				<p class="position-title">
					AVENIR
				</p>

				<img
					id="future-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="future-number"></p>

				<h2 id="future-name"></h2>

				<div
					class="keywords"
					id="future-keywords"
				></div>

				<p
					class="meaning"
					id="future-meaning"
				></p>

			</article>

		</div>

		<section class="synthesis">

	<p class="premium-label">
		✨ INTERPRÉTATION PERSONNALISÉE
	</p>

	<h2>
		Approfondissez votre tirage
	</h2>

	<p>
		Vos trois cartes vous donnent déjà les grandes tendances.
		Posez maintenant votre question pour obtenir une analyse
		personnalisée de votre tirage.
	</p>

	<div class="premium-benefits">
		<p>✓ Analyse de votre question</p>
		<p>✓ Interaction entre les 3 cartes</p>
		<p>✓ Tendances mises en lumière</p>
		<p>✓ Conseil personnalisé</p>
	</div>

	<p class="premium-price">
		2,99 €
	</p>

	<textarea
		id="tarot-question"
		class="tarot-question"
		maxlength="500"
		rows="4"
		placeholder="Posez votre question ici…"
	></textarea>

	<button
		type="button"
		class="premium-button"
		id="ask-gemini"
	>
		🔒 Débloquer mon interprétation
	</button>

	<p
		id="ai-status"
		class="ai-status"
	></p>

	<div
		id="ai-result"
		class="ai-result hidden"
	></div>

</section>

		<div class="actions">

			<button
				type="button"
				id="new-reading"
				class="new-reading"
			>
				↻ Faire un nouveau tirage
			</button>

			<a
				href="/tarot/"
				class="back-link"
			>
				← Retour aux tirages
			</a>

		</div>

	</section>

	<section class="disclaimer">
		<p>
			Le tarot proposé sur Astres & Numéros est un outil de réflexion
			et de divertissement. Les interprétations ne constituent pas
			des prédictions certaines de l’avenir.
		</p>
	</section>

	<script define:vars={{ tarotCards }}>

		const cards = tarotCards;

		const deck =
			document.getElementById("deck");

		const choiceZone =
			document.getElementById("choice-zone");

		const result =
			document.getElementById("result");

		const instructionText =
			document.getElementById("instruction-text");

		const newReading =
			document.getElementById("new-reading");

		const tarotQuestion =
	        document.getElementById("tarot-question");

        const askGemini =
	        document.getElementById("ask-gemini");

        const aiStatus =
	        document.getElementById("ai-status");
 
        const aiResult =
	        document.getElementById("ai-result");	

		const selectedCards = [];

		const labels = [
			"passé",
			"présent",
			"avenir"
		];

		const instructions = [
			"Choisissez une carte pour représenter votre passé.",
			"Choisissez maintenant une carte pour votre présent.",
			"Choisissez enfin une carte pour votre avenir."
		];

		function shuffleDeck() {

			const elements =
				Array.from(
					deck.querySelectorAll(".card-back")
				);

			for (
				let i = elements.length - 1;
				i > 0;
				i--
			) {

				const j =
					Math.floor(
						Math.random() * (i + 1)
					);

				const temp =
					elements[i];

				elements[i] =
					elements[j];

				elements[j] =
					temp;
			}

			elements.forEach(
				(element) => {
					deck.appendChild(element);
				}
			);

		}

		function updateProgress() {

			document
				.querySelectorAll(".progress-step")
				.forEach(
					(step => {
						step.classList.remove(
							"active",
							"done"
						);
					})
				);

			for (
				let i = 0;
				i < selectedCards.length;
				i++
			) {
				document
					.getElementById(`step-${i}`)
					.classList.add("done");
			}

			if (selectedCards.length < 3) {

				document
					.getElementById(
						`step-${selectedCards.length}`
					)
					.classList.add("active");

			}

		}

		function createKeywords(
			container,
			keywords
		) {

			container.innerHTML = "";

			keywords.forEach(
				(keyword) => {

					const span =
						document.createElement(
							"span"
						);

					span.textContent =
						keyword;

					container.appendChild(
						span
					);

				}
			);

		}

		function fillCard(
			prefix,
			card
		) {

			const image =
				document.getElementById(
					`${prefix}-image`
				);

			const number =
				document.getElementById(
					`${prefix}-number`
				);

			const name =
				document.getElementById(
					`${prefix}-name`
				);

			const keywords =
				document.getElementById(
					`${prefix}-keywords`
				);

			const meaning =
				document.getElementById(
					`${prefix}-meaning`
				);

			image.src =
				card.image;

			image.alt =
				card.name;

			number.textContent =
				card.id === 0
					? "ARCANE • LE MAT"
					: `ARCANE ${card.id}`;

			name.textContent =
				card.name;

			meaning.textContent =
				card.shortMeaning;

			createKeywords(
				keywords,
				card.keywords
			);

		}

		function showResult() {

			fillCard(
				"past",
				selectedCards[0]
			);

			fillCard(
				"present",
				selectedCards[1]
			);

			fillCard(
				"future",
				selectedCards[2]
			);

			choiceZone.classList.add(
				"fade-out"
			);

			setTimeout(
				() => {

					choiceZone.style.display =
						"none";

					result.classList.remove(
						"hidden"
					);

					requestAnimationFrame(
						() => {

							result.classList.add(
								"show"
							);

						}
					);

					window.scrollTo({
						top:
							result.offsetTop - 100,
						behavior:
							"smooth"
					});

				},
				350
			);

		}

		document
			.querySelectorAll(".card-back")
			.forEach(
				(button) => {

					button.addEventListener(
						"click",
						() => {

							if (
								selectedCards.length >= 3 ||
								button.classList.contains(
									"selected"
								)
							) {
								return;
							}

							const index =
								Number(
									button.dataset.index
								);

							const card =
								cards[index];

							selectedCards.push(
								card
							);

							button.classList.add(
								"selected"
							);

							button.disabled =
								true;

							updateProgress();

							if (
								selectedCards.length < 3
							) {

								instructionText.textContent =
									instructions[
										selectedCards.length
									];

							} else {

								instructionText.textContent =
									"Votre tirage est prêt.";


									document
    .querySelectorAll(".card-back")
    .forEach((cardButton) => {
        cardButton.disabled = true;
    });
								setTimeout(
									showResult,
									500
								);

							}

						}
					);

				}
			);

		newReading.addEventListener(
			"click",
			() => {

				selectedCards.length = 0;

				document
					.querySelectorAll(".card-back")
					.forEach(
						(button) => {

							button.classList.remove(
								"selected"
							);

							button.disabled =
								false;
                            button.style.pointerEvents = "";
                            button.removeAttribute("aria-disabled");
						}
					);
aiResult.textContent = "";
aiResult.classList.add("hidden");

aiStatus.textContent = "";
tarotQuestion.disabled = false;
tarotQuestion.value = "";

askGemini.disabled = false;
askGemini.textContent = "🔒 Débloquer mon interprétation";


const resultSection =
    document.getElementById("result");

resultSection.classList.remove("show");
resultSection.classList.add("hidden");

localStorage.removeItem("pendingTarotReading");

window.scrollTo({
    top: 0,
    behavior: "smooth"
});
				result.classList.remove(
					"show"
				);

				setTimeout(
					() => {

						result.classList.add(
							"hidden"
						);

						choiceZone.style.display =
							"block";

						choiceZone.classList.remove(
							"fade-out"
						);

						instructionText.textContent =
							instructions[0];

						updateProgress();

						shuffleDeck();

						window.scrollTo({
							top:
								choiceZone.offsetTop - 100,
							behavior:
								"smooth"
						});

					},
					300
				);

			}
		);

askGemini.addEventListener(
	"click",
	async () => {

		const question =
			tarotQuestion.value.trim();

		if (!question) {
			aiStatus.textContent =
				"Veuillez poser une question avant de continuer.";
			return;
		}

		if (selectedCards.length !== 3) {
			aiStatus.textContent =
				"Veuillez d'abord terminer votre tirage.";
			return;
		}

		askGemini.disabled = true;
		askGemini.textContent =
			"Redirection vers le paiement…";

		aiStatus.textContent =
			"Préparation du paiement sécurisé…";

		const tarotData = {
			question,
			type:
				"Tirage 3 cartes - Passé, Présent, Avenir",

			cards: [
				{
					name: selectedCards[0].name,
					position: "Passé"
				},
				{
					name: selectedCards[1].name,
					position: "Présent"
				},
				{
					name: selectedCards[2].name,
					position: "Avenir"
				}
			]
		};

		localStorage.setItem(
			"pendingTarotReading",
			JSON.stringify(tarotData)
		);

		try {

			const response =
				await fetch(
					"/api/create-checkout",
					{
						method: "POST",
						headers: {
							"Content-Type":
								"application/json"
						}
					}
				);

			const data =
				await response.json();

			if (!response.ok || !data.url) {
				throw new Error(
					data.error ||
					"Impossible de préparer le paiement."
				);
			}

			window.location.href =
				data.url;

		} catch (error) {

			aiStatus.textContent =
				error.message ||
				"Une erreur est survenue.";

			askGemini.disabled = false;

			askGemini.textContent =
				"🔒 Débloquer mon interprétation";
		}
	}
);



async function handleStripeReturn() {

	const params =
		new URLSearchParams(
			window.location.search
		);

	const payment =
		params.get("payment");

	const sessionId =
		params.get("session_id");

	if (payment === "cancel") {
		aiStatus.textContent =
			"Paiement annulé. Aucun montant n'a été débité.";
		return;
	}

	if (
		payment !== "success" ||
		!sessionId
	) {
		return;
	}
document
    .querySelectorAll(".card-back")
    .forEach((button) => {
        button.style.pointerEvents = "none";
        button.setAttribute("aria-disabled", "true");
    });
	aiStatus.textContent =
		"Vérification de votre paiement…";

	try {

		const verifyResponse =
			await fetch(
				`/api/verify-payment?session_id=${encodeURIComponent(sessionId)}`
			);

		const verifyData =
			await verifyResponse.json();

		if (
			!verifyResponse.ok ||
			!verifyData.paid
		) {
			throw new Error(
				verifyData.error ||
				"Le paiement n'a pas pu être confirmé."
			);
		}

		const saved =
			localStorage.getItem(
				"pendingTarotReading"
			);

		if (!saved) {
			throw new Error(
				"Votre tirage n'a pas été retrouvé."
			);
		}

		const tarotData =
			JSON.parse(saved);

const resultSection = document.getElementById("result");
resultSection.classList.remove("hidden");
resultSection.classList.add("show");

aiResult.classList.remove("hidden");
aiResult.innerHTML = `
    <div class="interpretation-loading">
        <div class="loading-hourglass">⌛</div>
        <strong>Votre interprétation est en cours de préparation</strong>
        <span>Nous analysons votre tirage et votre question…</span>
        <span>Cela peut prendre quelques secondes.</span>
    </div>
`;

aiResult.scrollIntoView({
    behavior: "smooth",
    block: "center"
});


		aiStatus.textContent =
			"Paiement confirmé. Préparation de votre interprétation…";

		const tarotResponse =
			await fetch(
				"/api/tarot",
				{
					method: "POST",

					headers: {
						"Content-Type":
							"application/json"
					},

					body:
    JSON.stringify({
        ...tarotData,
        sessionId
    })
				}
			);

		const tarotResult =
			await tarotResponse.json();

		if (!tarotResponse.ok) {
			throw new Error(
				tarotResult.error ||
					"L'interprétation est momentanément indisponible."
			);
		}

		aiStatus.textContent = "";

		aiResult.textContent =
			tarotResult.interpretation;
tarotQuestion.disabled = true;
askGemini.disabled = true;
askGemini.textContent = "Interprétation obtenue";
		

		aiResult.classList.remove(
			"hidden"
		);

resultSection.classList.remove("hidden");
resultSection.classList.add("show");


aiResult.style.display = "block";
aiResult.style.opacity = "1";
aiResult.style.transform = "none";
aiResult.style.visibility = "visible";



		localStorage.removeItem(
			"pendingTarotReading"
		);

		window.history.replaceState(
			{},
			"",
			window.location.pathname
		);

		aiResult.scrollIntoView({
			behavior: "smooth",
			block: "start"
		});

	} catch (error) {
  console.error("ERREUR RETOUR STRIPE :", error);
		aiStatus.textContent =
			error.message ||
			"Une erreur est survenue.";
	}
}

shuffleDeck();
updateProgress();

handleStripeReturn();

	</script>

</Layout>

<style>

	.hero {
		max-width: 780px;
		margin: 0 auto 2rem;
		text-align: center;
	}

	.eyebrow {
		color: #fbbf24;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		margin-bottom: 0.8rem;
	}

	.hero h1 {
		color: #fbbf24;
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 1rem;
	}

	.hero p {
		color: #cbd5e1;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.progress-box {
		display: flex;
		align-items: center;
		justify-content: center;
		max-width: 700px;
		margin: 0 auto 2rem;
	}

	.progress-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		min-width: 80px;
		color: #94a3b8;
	}

	.progress-step span {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 1px solid rgba(255,255,255,.18);
		background: rgba(30,41,59,.8);
		font-weight: 700;
	}

	.progress-step.active {
		color: #fbbf24;
	}

	.progress-step.active span {
		border-color: #fbbf24;
		box-shadow: 0 0 18px rgba(251,191,36,.18);
	}

	.progress-step.done {
		color: #c7d2fe;
	}

	.progress-step.done span {
		background: #818cf8;
		color: white;
		border-color: #818cf8;
	}

	.progress-line {
		width: 80px;
		height: 1px;
		background: rgba(255,255,255,.15);
		margin: 0 0.5rem 1.6rem;
	}

	.instructions {
		max-width: 650px;
		margin: 0 auto 2rem;
		padding: 1rem 1.3rem;
		text-align: center;
		background: rgba(129,140,248,.1);
		border: 1px solid rgba(129,140,248,.25);
		border-radius: 12px;
		color: #e2e8f0;
	}

	.deck {
		display: grid;
		grid-template-columns: repeat(11, 1fr);
		gap: 0.7rem;
		max-width: 1000px;
		margin: 0 auto 3rem;
	}

	.card-back {
		aspect-ratio: 2 / 3.4;
		padding: 5px;
		border-radius: 9px;
		border: 1px solid rgba(251,191,36,.55);
		background: linear-gradient(145deg,#312e81,#111827);
		cursor: pointer;
		box-shadow: 0 6px 15px rgba(0,0,0,.25);
		transition:
			transform .2s ease,
			opacity .2s ease,
			box-shadow .2s ease;
	}

	.card-back:hover:not(:disabled) {
		transform: translateY(-10px) scale(1.04);
		box-shadow: 0 14px 25px rgba(0,0,0,.45);
	}

	.card-back.selected {
		opacity: .22;
		transform: scale(.92);
		cursor: default;
	}

	.card-pattern {
		width: 100%;
		height: 100%;
		border: 1px solid rgba(251,191,36,.45);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(
				circle at center,
				rgba(129,140,248,.35),
				transparent 60%
			);
		color: #fbbf24;
	}

	.moon {
		font-size: 1.6rem;
		line-height: 1;
	}

	.star {
		font-size: .9rem;
		margin-top: .2rem;
	}

	.brand-small {
		font-size: .45rem;
		margin-top: .5rem;
		letter-spacing: .1em;
	}

	#choice-zone {
		opacity: 1;
		transition:
			opacity .35s ease,
			transform .35s ease;
	}

	#choice-zone.fade-out {
		opacity: 0;
		transform: translateY(-10px);
	}

	.result {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity .4s ease,
			transform .4s ease;
	}

	.result.hidden {
		display: none;
	}

	.result.show {
		opacity: 1;
		transform: translateY(0);
	}

	.result-label {
		text-align: center;
		color: #fbbf24;
		font-size: .82rem;
		font-weight: 700;
		letter-spacing: .18em;
		margin-bottom: 1.5rem;
	}

	.spread {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.3rem;
		margin-bottom: 2.5rem;
	}

	.spread-card {
		padding: 1.4rem;
		background: rgba(30,41,59,.72);
		border: 1px solid rgba(251,191,36,.25);
		border-radius: 16px;
		text-align: center;
		box-shadow: 0 12px 30px rgba(0,0,0,.25);
	}

	.position-title {
		color: #818cf8;
		font-size: .8rem;
		font-weight: 700;
		letter-spacing: .14em;
		margin-bottom: 1rem;
	}

