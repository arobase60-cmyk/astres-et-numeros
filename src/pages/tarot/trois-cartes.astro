---
import Layout from '../../layouts/Layout.astro';
import { tarotCards } from '../../data/tarot';
import AdBanner from '../../components/AdBanner.astro';
---

<Layout
	title="Tirage Tarot 3 cartes gratuit - Passé, présent, avenir | Astres & Numéros"
	description="Faites gratuitement un tirage de tarot à 3 cartes pour explorer votre passé, votre présent et votre avenir et découvrir le message des cartes."
>

	<section class="hero">
		<p class="eyebrow">TIRAGE 3 CARTES</p>

		<h1>Passé · Présent · Avenir</h1>

		<p>
			Pensez à une situation précise, puis choisissez trois cartes.
			La première représentera le passé, la deuxième le présent
			et la troisième l’avenir.
		</p>
	</section>

	<section class="progress-box">
		<div class="progress-step active" id="step-0">
			<span>1</span>
			<p>Passé</p>
		</div>

		<div class="progress-line"></div>

		<div class="progress-step" id="step-1">
			<span>2</span>
			<p>Présent</p>
		</div>

		<div class="progress-line"></div>

		<div class="progress-step" id="step-2">
			<span>3</span>
			<p>Avenir</p>
		</div>
	</section>

	<section id="choice-zone">

		<div class="instructions">
			<p id="instruction-text">
				Choisissez une carte pour représenter votre passé.
			</p>
		</div>

		<div class="deck" id="deck">

			{tarotCards.map((card, index) => (

				<button
					class="card-back"
					type="button"
					data-index={index}
					aria-label={`Choisir la carte ${index + 1}`}
				>
					<div class="card-pattern">
						<div class="moon">☾</div>
						<div class="star">✦</div>
						<div class="brand-small">A & N</div>
					</div>
				</button>

			))}

		</div>

	</section>

	<section class="result hidden" id="result">

		<p class="result-label">
			VOTRE TIRAGE
		</p>

		<div class="spread">

			<article class="spread-card">

				<p class="position-title">
					PASSÉ
				</p>

				<img
					id="past-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="past-number"></p>

				<h2 id="past-name"></h2>

				<div
					class="keywords"
					id="past-keywords"
				></div>

				<p
					class="meaning"
					id="past-meaning"
				></p>

			</article>

			<article class="spread-card">

				<p class="position-title">
					PRÉSENT
				</p>

				<img
					id="present-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="present-number"></p>

				<h2 id="present-name"></h2>

				<div
					class="keywords"
					id="present-keywords"
				></div>

				<p
					class="meaning"
					id="present-meaning"
				></p>

			</article>

			<article class="spread-card">

				<p class="position-title">
					AVENIR
				</p>

				<img
					id="future-image"
					src=""
					alt=""
				/>

				<p class="arcane-number" id="future-number"></p>

				<h2 id="future-name"></h2>

				<div
					class="keywords"
					id="future-keywords"
				></div>

				<p
					class="meaning"
					id="future-meaning"
				></p>

			</article>

		</div>

		<section class="synthesis">

  <p class="premium-label">
    ✨ SYNTHÈSE DE VOTRE TIRAGE
  </p>

  <h2>
    Le message de vos trois cartes
  </h2>

  <p>
    Découvrez comment les symboles de votre passé,
    de votre présent et de votre avenir
    peuvent se compléter.
  </p>

  <p id="reading-synthesis" aria-live="polite"></p>

</section>
		<div class="actions">

			<button
				type="button"
				id="new-reading"
				class="new-reading"
			>
				↻ Faire un nouveau tirage
			</button>

			<a
				href="/tarot/"
				class="back-link"
			>
				← Retour aux tirages
			</a>

		</div>

	</section>

<section class="disclaimer">
    <h2>Comment interpréter un tirage de Tarot à 3 cartes ?</h2>

    <p>
        Le tirage Passé, Présent, Avenir est une méthode
        traditionnelle pour explorer une situation sous
        trois angles complémentaires.
    </p>

    <h3>La première carte : le Passé</h3>
    <p>
        Elle représente les événements, les expériences
        ou les influences qui ont contribué à votre
        situation actuelle. Elle invite à comprendre
        ce qui vous a conduit jusqu'ici.
    </p>

    <h3>La deuxième carte : le Présent</h3>
    <p>
        Elle symbolise votre situation actuelle,
        vos préoccupations et les éléments auxquels
        vous pouvez accorder votre attention.
    </p>

    <h3>La troisième carte : l'Avenir</h3>
    <p>
        Elle suggère une évolution possible ou une
        direction à explorer. Elle ne constitue pas
        une prédiction certaine de ce qui arrivera.
    </p>

    <p>
        L'interprétation prend tout son sens lorsque
        les trois cartes sont considérées ensemble.
        Leurs symboles permettent de réfléchir aux
        liens entre vos expériences passées, votre
        situation présente et vos possibilités d'évolution.
    </p>
</section>



<AdBanner />
	<section class="disclaimer">
		<p>
			Le tarot proposé sur Astres & Numéros est un outil de réflexion
			et de divertissement. Les interprétations ne constituent pas
			des prédictions certaines de l’avenir.
		</p>
	</section>

	<script define:vars={{ tarotCards }}>

		const cards = tarotCards;

		const deck =
			document.getElementById("deck");

		const choiceZone =
			document.getElementById("choice-zone");

		const result =
			document.getElementById("result");

		const instructionText =
			document.getElementById("instruction-text");

		const newReading =
			document.getElementById("new-reading");

		

		const selectedCards = [];

		const labels = [
			"passé",
			"présent",
			"avenir"
		];

		const instructions = [
			"Choisissez une carte pour représenter votre passé.",
			"Choisissez maintenant une carte pour votre présent.",
			"Choisissez enfin une carte pour votre avenir."
		];

		function shuffleDeck() {

			const elements =
				Array.from(
					deck.querySelectorAll(".card-back")
				);

			for (
				let i = elements.length - 1;
				i > 0;
				i--
			) {

				const j =
					Math.floor(
						Math.random() * (i + 1)
					);

				const temp =
					elements[i];

				elements[i] =
					elements[j];

				elements[j] =
					temp;
			}

			elements.forEach(
				(element) => {
					deck.appendChild(element);
				}
			);

		}

		function updateProgress() {

			document
				.querySelectorAll(".progress-step")
				.forEach(
					(step => {
						step.classList.remove(
							"active",
							"done"
						);
					})
				);

			for (
				let i = 0;
				i < selectedCards.length;
				i++
			) {
				document
					.getElementById(`step-${i}`)
					.classList.add("done");
			}

			if (selectedCards.length < 3) {

				document
					.getElementById(
						`step-${selectedCards.length}`
					)
					.classList.add("active");

			}

		}

		function createKeywords(
			container,
			keywords
		) {

			container.innerHTML = "";

			keywords.forEach(
				(keyword) => {

					const span =
						document.createElement(
							"span"
						);

					span.textContent =
						keyword;

					container.appendChild(
						span
					);

				}
			);

		}

		function fillCard(
			prefix,
			card
		) {

			const image =
				document.getElementById(
					`${prefix}-image`
				);

			const number =
				document.getElementById(
					`${prefix}-number`
				);

			const name =
				document.getElementById(
					`${prefix}-name`
				);

			const keywords =
				document.getElementById(
					`${prefix}-keywords`
				);

			const meaning =
				document.getElementById(
					`${prefix}-meaning`
				);

			image.src =
				card.image;

			image.alt =
				card.name;

			number.textContent =
				card.id === 0
					? "ARCANE • LE MAT"
					: `ARCANE ${card.id}`;

			name.textContent =
				card.name;

			meaning.textContent =
				card.shortMeaning;

			createKeywords(
				keywords,
				card.keywords
			);

		}

function generateSynthesis() {
    const [past, present, future] = selectedCards;

    const synthesis = document.getElementById(
        "reading-synthesis"
    );

    if (!synthesis || !past || !present || !future) {
        return;
    }

    const pastKeywords = past.keywords.join(", ");
    const presentKeywords = present.keywords.join(", ");
    const futureKeywords = future.keywords.join(", ");

    synthesis.textContent =
        `Votre passé est représenté par ${past.name}, ` +
        `une carte associée à ${pastKeywords}. ` +
        `Elle vous invite à réfléchir aux expériences ` +
        `qui ont influencé votre situation actuelle.\n\n` +

        `Dans votre présent, ${present.name} met en lumière ` +
        `les thèmes de ${presentKeywords}. ` +
        `Ces symboles peuvent vous aider à mieux comprendre ` +
        `vos préoccupations du moment.\n\n` +

        `Pour votre avenir, ${future.name} évoque ` +
        `${futureKeywords}. ` +
        `Cette carte suggère une direction possible, ` +
        `sans prédire avec certitude les événements à venir.\n\n` +

        `Ensemble, ces trois cartes proposent une réflexion ` +
        `sur votre cheminement : ce qui vous a marqué, ` +
        `ce qui vous occupe aujourd'hui et les possibilités ` +
        `que vous souhaitez explorer.`;
}



		function showResult() {

			fillCard(
				"past",
				selectedCards[0]
			);

			fillCard(
				"present",
				selectedCards[1]
			);

			fillCard(
				"future",
				selectedCards[2]
			);
generateSynthesis();
			choiceZone.classList.add(
				"fade-out"
			);

			setTimeout(
				() => {

					choiceZone.style.display =
						"none";

					result.classList.remove(
						"hidden"
					);

					requestAnimationFrame(
						() => {

							result.classList.add(
								"show"
							);

						}
					);

					window.scrollTo({
						top:
							result.offsetTop - 100,
						behavior:
							"smooth"
					});

				},
				350
			);

		}

		document
			.querySelectorAll(".card-back")
			.forEach(
				(button) => {

					button.addEventListener(
						"click",
						() => {

							if (
								selectedCards.length >= 3 ||
								button.classList.contains(
									"selected"
								)
							) {
								return;
							}

							const index =
								Number(
									button.dataset.index
								);

							const card =
								cards[index];

							selectedCards.push(
								card
							);

							button.classList.add(
								"selected"
							);

							button.disabled =
								true;

							updateProgress();

							if (
								selectedCards.length < 3
							) {

								instructionText.textContent =
									instructions[
										selectedCards.length
									];

							} else {

								instructionText.textContent =
									"Votre tirage est prêt.";


									document
    .querySelectorAll(".card-back")
    .forEach((cardButton) => {
        cardButton.disabled = true;
    });
								setTimeout(
									showResult,
									500
								);

							}

						}
					);

				}
			);

		newReading.addEventListener(
			"click",
			() => {

				selectedCards.length = 0;

				document
					.querySelectorAll(".card-back")
					.forEach(
						(button) => {

							button.classList.remove(
								"selected"
							);

							button.disabled =
								false;
                            button.style.pointerEvents = "";
                            button.removeAttribute("aria-disabled");
						}
					);


const resultSection =
    document.getElementById("result");

resultSection.classList.remove("show");
resultSection.classList.add("hidden");



window.scrollTo({
    top: 0,
    behavior: "smooth"
});
				result.classList.remove(
					"show"
				);

				setTimeout(
					() => {

						result.classList.add(
							"hidden"
						);

						choiceZone.style.display =
							"block";

						choiceZone.classList.remove(
							"fade-out"
						);

						instructionText.textContent =
							instructions[0];

						updateProgress();

						shuffleDeck();

						window.scrollTo({
							top:
								choiceZone.offsetTop - 100,
							behavior:
								"smooth"
						});

					},
					300
				);

			}
		);







shuffleDeck();
updateProgress();



	</script>

</Layout>

<style>

	.hero {
		max-width: 780px;
		margin: 0 auto 2rem;
		text-align: center;
	}

	.eyebrow {
		color: #fbbf24;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		margin-bottom: 0.8rem;
	}

	.hero h1 {
		color: #fbbf24;
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 1rem;
	}

	.hero p {
		color: #cbd5e1;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.progress-box {
		display: flex;
		align-items: center;
		justify-content: center;
		max-width: 700px;
		margin: 0 auto 2rem;
	}

	.progress-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		min-width: 80px;
		color: #94a3b8;
	}

	.progress-step span {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 1px solid rgba(255,255,255,.18);
		background: rgba(30,41,59,.8);
		font-weight: 700;
	}

	.progress-step.active {
		color: #fbbf24;
	}

	.progress-step.active span {
		border-color: #fbbf24;
		box-shadow: 0 0 18px rgba(251,191,36,.18);
	}

	.progress-step.done {
		color: #c7d2fe;
	}

	.progress-step.done span {
		background: #818cf8;
		color: white;
		border-color: #818cf8;
	}

	.progress-line {
		width: 80px;
		height: 1px;
		background: rgba(255,255,255,.15);
		margin: 0 0.5rem 1.6rem;
	}

	.instructions {
		max-width: 650px;
		margin: 0 auto 2rem;
		padding: 1rem 1.3rem;
		text-align: center;
		background: rgba(129,140,248,.1);
		border: 1px solid rgba(129,140,248,.25);
		border-radius: 12px;
		color: #e2e8f0;
	}

	.deck {
		display: grid;
		grid-template-columns: repeat(11, 1fr);
		gap: 0.7rem;
		max-width: 1000px;
		margin: 0 auto 3rem;
	}

	.card-back {
		aspect-ratio: 2 / 3.4;
		padding: 5px;
		border-radius: 9px;
		border: 1px solid rgba(251,191,36,.55);
		background: linear-gradient(145deg,#312e81,#111827);
		cursor: pointer;
		box-shadow: 0 6px 15px rgba(0,0,0,.25);
		transition:
			transform .2s ease,
			opacity .2s ease,
			box-shadow .2s ease;
	}

	.card-back:hover:not(:disabled) {
		transform: translateY(-10px) scale(1.04);
		box-shadow: 0 14px 25px rgba(0,0,0,.45);
	}

	.card-back.selected {
		opacity: .22;
		transform: scale(.92);
		cursor: default;
	}

	.card-pattern {
		width: 100%;
		height: 100%;
		border: 1px solid rgba(251,191,36,.45);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(
				circle at center,
				rgba(129,140,248,.35),
				transparent 60%
			);
		color: #fbbf24;
	}

	.moon {
		font-size: 1.6rem;
		line-height: 1;
	}

	.star {
		font-size: .9rem;
		margin-top: .2rem;
	}

	.brand-small {
		font-size: .45rem;
		margin-top: .5rem;
		letter-spacing: .1em;
	}

	#choice-zone {
		opacity: 1;
		transition:
			opacity .35s ease,
			transform .35s ease;
	}

	#choice-zone.fade-out {
		opacity: 0;
		transform: translateY(-10px);
	}

	.result {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity .4s ease,
			transform .4s ease;
	}

	.result.hidden {
		display: none;
	}

	.result.show {
		opacity: 1;
		transform: translateY(0);
	}

	.result-label {
		text-align: center;
		color: #fbbf24;
		font-size: .82rem;
		font-weight: 700;
		letter-spacing: .18em;
		margin-bottom: 1.5rem;
	}

	.spread {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.3rem;
		margin-bottom: 2.5rem;
	}

	.spread-card {
		padding: 1.4rem;
		background: rgba(30,41,59,.72);
		border: 1px solid rgba(251,191,36,.25);
		border-radius: 16px;
		text-align: center;
		box-shadow: 0 12px 30px rgba(0,0,0,.25);
	}

	.position-title {
		color: #818cf8;
		font-size: .8rem;
		font-weight: 700;
		letter-spacing: .14em;
		margin-bottom: 1rem;
	}

	.spread-card img {
		width: 100%;
		max-width: 240px;
		max-height: 390px;
		object-fit: contain;
		border-radius: 9px;
		box-shadow: 0 12px 25px rgba(0,0,0,.4);
		margin-bottom: 1rem;
	}

	.arcane-number {
		color: #818cf8;
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .12em;
		margin-bottom: .4rem;
	}

	.spread-card h2 {
		color: #fbbf24;
		font-size: 1.35rem;
		margin-bottom: .8rem;
	}

	.keywords {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: .4rem;
		margin-bottom: 1rem;
	}

	.keywords span {
		padding: .35rem .6rem;
		background: rgba(129,140,248,.14);
		border: 1px solid rgba(129,140,248,.28);
		border-radius: 999px;
		color: #c7d2fe;
		font-size: .75rem;
	}

	.meaning {
		color: #cbd5e1;
		font-size: .95rem;
		line-height: 1.65;
	}

	.synthesis {
		max-width: 900px;
		margin: 0 auto 2rem;
		padding: 2rem;
		text-align: center;
		background:
			linear-gradient(
				135deg,
				rgba(129,140,248,.15),
				rgba(251,191,36,.10)
			);
		border: 1px solid rgba(251,191,36,.3);
		border-radius: 16px;
	}

	.premium-label {
		color: #fbbf24;
		font-size: .78rem;
		font-weight: 700;
		letter-spacing: .13em;
		margin-bottom: .7rem;
	}

	.synthesis h2 {
		color: #f8fafc;
		margin-bottom: .8rem;
	}

	.synthesis p {
		max-width: 650px;
		margin: 0 auto 1.3rem;
		color: #cbd5e1;
		line-height: 1.6;
	}


.premium-benefits {
	max-width: 430px;
	margin: 1.4rem auto;
	padding: 1.2rem 1.5rem;
	text-align: left;
	background: rgba(15,23,42,.45);
	border-radius: 12px;
}

.synthesis .premium-benefits p {
	margin: .55rem 0;
	color: #e2e8f0;
	font-size: .95rem;
}

.premium-price {
	margin: 1.2rem auto .5rem !important;
	color: #fbbf24 !important;
	font-size: 2rem !important;
	font-weight: 800;
}



	.premium-button {
	padding: .9rem 1.5rem;
	border: none;
	border-radius: 9px;
	background: #fbbf24;
	color: #111827;
	font-weight: 700;
	cursor: pointer;
	transition:
		transform .2s ease,
		opacity .2s ease;
}

.premium-button:hover:not(:disabled) {
	transform: translateY(-2px);
}

.premium-button:disabled {
	opacity: .55;
	cursor: wait;
}

.tarot-question {
	display: block;
	width: 100%;
	max-width: 650px;
	margin: 1.2rem auto;
	padding: 1rem;
	box-sizing: border-box;
	border-radius: 10px;
	border: 1px solid rgba(251,191,36,.35);
	background: rgba(15,23,42,.75);
	color: #f8fafc;
	font: inherit;
	line-height: 1.5;
	resize: vertical;
}

.tarot-question::placeholder {
	color: #94a3b8;
}

.tarot-question:focus {
	outline: none;
	border-color: #fbbf24;
}

.ai-status {
	margin-top: 1rem !important;
	color: #fbbf24 !important;
	font-weight: 600;
}

.ai-result {
	max-width: 760px;
	margin: 1.5rem auto 0;
	padding: 1.5rem;
	text-align: left;
	white-space: pre-wrap;
	background: rgba(15,23,42,.72);
	border: 1px solid rgba(129,140,248,.3);
	border-radius: 12px;
	color: #e2e8f0;
	line-height: 1.75;
}

.ai-result.hidden {
	display: none;
