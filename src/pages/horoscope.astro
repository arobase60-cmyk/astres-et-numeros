---
import Layout from '../layouts/Layout.astro';
import { WESTERN_SIGNS } from '../utils/astrology.js';
import AdBanner from '../components/AdBanner.astro';
---

<Layout
	title="Horoscope du jour gratuit – Les 12 signes | Astres & Numéros"
	description="Consultez gratuitement votre horoscope du jour selon votre signe astrologique : Bélier, Taureau, Gémeaux, Cancer, Lion, Vierge, Balance, Scorpion, Sagittaire, Capricorne, Verseau et Poissons."
>
	<div class="page-header">
		<h1>✨ Horoscope Occidental</h1>
		<p class="date" id="horoscope-date">Chargement de la date...</p>
        <p class="subtitle">Cliquez sur votre signe pour découvrir votre horoscope du jour</p>
	   </div>


<section class="horoscope-intro">
    <h2>Comprendre votre horoscope du jour</h2>

    <p>
        L'horoscope occidental repose sur les douze signes
        du zodiaque, déterminés à partir de la période
        de naissance. Chaque signe est traditionnellement
        associé à des caractéristiques et à des symboles
        astrologiques particuliers.
    </p>

    <p>
        Sur Astres & Numéros, votre horoscope quotidien
        propose trois axes de réflexion : votre situation
        générale, vos relations sentimentales et vos
        activités professionnelles ou projets personnels.
    </p>

    <p>
        Ces interprétations astrologiques sont proposées
        à titre de divertissement et de réflexion personnelle.
        Elles ne constituent pas des prédictions certaines
        des événements à venir.
    </p>
</section>


<AdBanner />
	<div class="signs-grid">
		{WESTERN_SIGNS.map((sign) => {
			
			return (
				<details class="sign-card">
					<!-- La partie toujours visible : le bouton/titre du signe -->
					<summary class="card-header">
						<span class="symbol">{sign.symbol}</span>
						<div class="header-info">
							<h2>{sign.name}</h2>
							<span class="dates">{sign.dates}</span>
						</div>
						<span class="arrow">▼</span>
					</summary>
					
					<!-- Le contenu masqué qui s'affiche uniquement au clic -->
					<div class="card-content">
						<p class="prediction" data-sign={sign.name}>
    Chargement de votre horoscope...
</p>

<div class="numbers-section">
    <span class="numbers-title">5 chiffres chance du jour :</span>
    <div class="balls-container" data-numbers={sign.name}>
        Chargement...
    </div>
</div>
					</div>
				</details>
			);
		})}
	</div>


	<section class="zodiac-elements">
    <h2>Les quatre éléments du zodiaque</h2>

    <p>
        En astrologie occidentale, les douze signes sont répartis
        en quatre éléments. Chacun représente symboliquement
        une manière d'aborder les émotions, les relations
        et les expériences de la vie.
    </p>

    <h3>🔥 Les signes de Feu</h3>
    <p>
        Bélier, Lion et Sagittaire sont traditionnellement
        associés à l'énergie, à l'enthousiasme, à l'action
        et à l'esprit d'initiative.
    </p>

    <h3>🌿 Les signes de Terre</h3>
    <p>
        Taureau, Vierge et Capricorne symbolisent
        la stabilité, le pragmatisme, la patience
        et le sens des responsabilités.
    </p>

    <h3>🌬️ Les signes d'Air</h3>
    <p>
        Gémeaux, Balance et Verseau sont associés
        à la communication, à la curiosité intellectuelle,
        aux échanges et à la réflexion.
    </p>

    <h3>💧 Les signes d'Eau</h3>
    <p>
        Cancer, Scorpion et Poissons évoquent
        la sensibilité, l'intuition, l'imagination
        et la profondeur émotionnelle.
    </p>

    <p>
        Ces associations appartiennent à la tradition
        astrologique et ne définissent pas à elles seules
        la personnalité d'une personne.
    </p>
</section>
<section class="seo-links">
    <h2>Explorez votre profil astrologique</h2>
    <p>
        Votre signe solaire n’est qu’une partie de votre profil.
        Découvrez votre <a href="/theme-astral/">thème astral</a>
        ou testez votre <a href="/compatibilite/">compatibilité astrologique</a>.
    </p>
</section>

</Layout>

<style is:global>
.zodiac-elements {
    max-width: 950px;
    margin: 50px auto;
    padding: 30px;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 12px;
    text-align: center;
}

.zodiac-elements h2 {
    color: #fbbf24;
    font-size: 1.6rem;
    margin-bottom: 20px;
}

.zodiac-elements h3 {
    color: #fbbf24;
    font-size: 1.2rem;
    margin-top: 25px;
    margin-bottom: 10px;
}

.zodiac-elements p {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 15px;
}



.seo-links {
    max-width: 950px;
    margin: 40px auto;
    text-align: center;
}

.seo-links h2 {
    color: #fbbf24;
    margin-bottom: 15px;
}

.seo-links p {
    color: #cbd5e1;
    line-height: 1.8;
}

.seo-links a {
    color: #fbbf24;
    text-decoration: underline;
}

.seo-links a:hover {
    color: #fde68a;
}


.horoscope-intro {
    max-width: 950px;
    margin: 0 auto 40px;
    padding: 25px 30px;
    text-align: center;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(251, 191, 36, 0.2);
    border-radius: 12px;
}

.horoscope-intro h2 {
    color: #fbbf24;
    font-size: 1.5rem;
    margin-bottom: 20px;
}

.horoscope-intro p {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 15px;
}

.horoscope-intro p:last-child {
    margin-bottom: 0;
}



	.page-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.page-header h1 {
		font-size: 2.4rem;
		color: #fbbf24;
		margin-bottom: 0.4rem;
	}

	.date {
		color: #94a3b8;
		font-size: 1.1rem;
		text-transform: capitalize;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: #cbd5e1;
		font-size: 0.95rem;
		font-style: italic;
	}

	.signs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
		align-items: start;
	}

	/* Style du conteneur accordéon <details> */
	.sign-card {
		background: rgba(30, 41, 59, 0.7);
		border-radius: 12px;
		padding: 1rem 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.sign-card:hover {
		border-color: rgba(251, 191, 36, 0.5);
		background: rgba(30, 41, 59, 0.9);
	}

	/* Style de l'en-tête cliquable <summary> */
	.card-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		list-style: none; /* Masque la flèche par défaut du navigateur */
		user-select: none;
	}

	.card-header::-webkit-details-marker {
		display: none; /* Masque la flèche par défaut sur Safari/Chrome */
	}

	.symbol {
		font-size: 2.5rem;
		color: #818cf8;
	}

	.header-info {
		flex: 1;
	}

	.card-header h2 {
		font-size: 1.3rem;
		color: #f8fafc;
	}

	.dates {
		font-size: 0.85rem;
		color: #94a3b8;
	}

	/* Petite flèche personnalisée qui pivote au clic */
	.arrow {
		color: #fbbf24;
		font-size: 0.8rem;
		transition: transform 0.3s ease;
	}

	.sign-card[open] .arrow {
		transform: rotate(180deg);
	}

	/* Style du contenu déplié */
	.card-content {
		margin-top: 1.2rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		animation: fadeIn 0.3s ease-in-out;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-5px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.prediction {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #cbd5e1;
		margin-bottom: 1.2rem;
	}

	.numbers-section {
		background: rgba(15, 23, 42, 0.6);
		padding: 0.8rem;
		border-radius: 8px;
	}

	.numbers-title {
		display: block;
		font-size: 0.8rem;
		color: #fbbf24;
		margin-bottom: 0.5rem;
		text-align: center;
	}

	.balls-container {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.number-ball {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #fbbf24, #d97706);
    color: #0f172a;
    font-weight: bold;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
}
/* Présentation des trois rubriques de l'horoscope */

.horoscope-section {
    margin-bottom: 1.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.horoscope-section:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.horoscope-section h3 {
    color: #fbbf24;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
}

.horoscope-section p {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
}


</style>

<script>
    import { getDailyHoroscopeSections, getDailyNumbers } from '../utils/astrology.js';

    function updateHoroscope() {
        const today = new Date();

        // Afficher la date du jour
        const dateElement = document.getElementById('horoscope-date');

        if (dateElement) {
            dateElement.textContent = `Prédictions du ${today.toLocaleDateString('fr-FR', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            })}`;
        }

        // Actualiser les prédictions des 12 signes
        document.querySelectorAll<HTMLElement>('[data-sign]').forEach((element) => {
    const sign = element.dataset.sign;

    if (sign) {
        const predictions = getDailyHoroscopeSections(sign);

        element.innerHTML = `
            <div class="horoscope-section">
                <h3>✨ Général</h3>
                <p>${predictions.general}</p>
            </div>

            <div class="horoscope-section">
                <h3>❤️ Amour</h3>
                <p>${predictions.amour}</p>
            </div>

            <div class="horoscope-section">
                <h3>💼 Travail et projets</h3>
                <p>${predictions.travail}</p>
            </div>
        `;
    }
});

        // Actualiser les cinq chiffres de chaque signe
        document.querySelectorAll<HTMLElement>('[data-numbers]').forEach((container) => {
            const sign = container.dataset.numbers;

            if (sign) {
                const numbers = getDailyNumbers(sign);

                container.replaceChildren();

                numbers.forEach((number) => {
                    const ball = document.createElement('span');
                    ball.className = 'number-ball';
                    ball.textContent = String(number);
                    container.appendChild(ball);
                });
            }
        });
    }

    updateHoroscope();
</script>

