---
import Layout from '../layouts/Layout.astro';
import { CHINESE_SIGNS } from '../utils/astrology.js';
---

<Layout title="Portraits des Signes Chinois - Jouons avec les astres">
	<div class="page-header">
		<h1>🐉 Particularités des Signes Chinois</h1>
		<p class="subtitle">Symbolique, éléments et traits dominants des 12 animaux du zodiaque</p>
	</div>

	<div class="cards-container">
		{CHINESE_SIGNS.map((sign) => (
			<article class="sign-profile-card">
				<div class="card-top">
					<span class="symbol-large">{sign.symbol}</span>
					<div class="title-meta">
						<h2>{sign.name}</h2>
						<span class="element-text">Élément : {sign.element}</span>
					</div>
				</div>

				<p class="description">{sign.desc}</p>

				<div class="traits-section">
					<span class="traits-title">Qualités principales :</span>
					<div class="tags-list">
						{sign.traits.map((trait) => (
							<span class="tag">{trait}</span>
						))}
					</div>
				</div>
			</article>
		))}
	</div>
</Layout>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.page-header h1 {
		font-size: 2.4rem;
		color: #fbbf24;
		margin-bottom: 0.4rem;
	}

	.subtitle {
		color: #94a3b8;
		font-size: 1.05rem;
	}

	.cards-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.8rem;
	}

	.sign-profile-card {
		background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
		border: 1px solid rgba(251, 191, 36, 0.2);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.sign-profile-card:hover {
		transform: translateY(-4px);
		border-color: rgba(251, 191, 36, 0.5);
	}

	.card-top {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.symbol-large {
		font-size: 3rem;
		line-height: 1;
	}

	.title-meta h2 {
		font-size: 1.5rem;
		color: #f8fafc;
		margin-bottom: 0.2rem;
	}

	.element-text {
		font-size: 0.85rem;
		color: #fbbf24;
	}

	.description {
		color: #cbd5e1;
		font-size: 0.92rem;
		line-height: 1.6;
		margin-bottom: 1.2rem;
	}

	.traits-section {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: 0.8rem;
	}

	.traits-title {
		display: block;
		font-size: 0.8rem;
		color: #94a3b8;
		margin-bottom: 0.5rem;
	}

	.tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		background: rgba(251, 191, 36, 0.1);
		color: #fef08a;
		border: 1px solid rgba(251, 191, 36, 0.2);
		font-size: 0.8rem;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
	}
</style>